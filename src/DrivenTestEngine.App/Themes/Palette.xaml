<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Core palette ============================ -->
    <Color x:Key="Color.Window">#FF0A0C10</Color>
    <Color x:Key="Color.WindowAlt">#FF0E1117</Color>
    <Color x:Key="Color.Surface">#FF12171E</Color>
    <Color x:Key="Color.SurfaceRaised">#FF161C24</Color>
    <Color x:Key="Color.SurfaceHover">#FF1B222C</Color>
    <Color x:Key="Color.Border">#FF232B36</Color>
    <Color x:Key="Color.BorderSoft">#FF1A212A</Color>
    <Color x:Key="Color.BorderStrong">#FF2E3846</Color>
    <Color x:Key="Color.Text">#FFE8EEF6</Color>
    <Color x:Key="Color.TextSecondary">#FF98A6B6</Color>
    <Color x:Key="Color.TextMuted">#FF6A7684</Color>
    <Color x:Key="Color.Accent">#FF3B82F6</Color>
    <Color x:Key="Color.AccentBright">#FF6DA9FF</Color>
    <Color x:Key="Color.AccentDeep">#FF1D4ED8</Color>
    <Color x:Key="Color.AccentSoft">#FF16233A</Color>
    <Color x:Key="Color.Success">#FF34D399</Color>
    <Color x:Key="Color.Warning">#FFFBBF24</Color>
    <Color x:Key="Color.Danger">#FFF87171</Color>
    <Color x:Key="Color.Info">#FF60A5FA</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.WindowAlt" Color="{StaticResource Color.WindowAlt}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="{StaticResource Color.BorderSoft}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource Color.AccentDeep}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5D9BFF" Offset="0" />
        <GradientStop Color="#FF2F6BE0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.TitleBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF10151B" Offset="0" />
        <GradientStop Color="#FF0C1015" Offset="0.6" />
        <GradientStop Color="#FF0A0D12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EdgeTab" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2F6BE0" Offset="0" />
        <GradientStop Color="#FF1B3E86" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF141A22" Offset="0" />
        <GradientStop Color="#FF11161D" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Brush.AccentHalo" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#663B82F6" Offset="0" />
        <GradientStop Color="#003B82F6" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================ Icon geometries ============================ -->
