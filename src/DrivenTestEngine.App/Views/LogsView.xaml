<UserControl x:Class="DrivenTestEngine.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:inf="clr-namespace:DrivenTestEngine.App.Infrastructure"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="720">

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="0,0,0,8">
            <TextBlock Text="LIVE DETECTION LOGS" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- toolbar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource Input.Text}" Padding="8,5" FontSize="11"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}" Margin="8,0,0,0"
                              IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip="Auto-scroll to the newest entry" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Chip}" Margin="0,0,5,4"
                                    Content="{Binding Label}"
                                    Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Copy" Style="{StaticResource Button.Tiny}" Command="{Binding CopyCommand}" Margin="0,0,5,0" />
                    <Button Content="Clear" Style="{StaticResource Button.Tiny}" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- log list -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="2" Background="#FF0C1116">
            <Grid>
                <ListBox Style="{StaticResource Plain.ListBox}"
                         ItemContainerStyle="{StaticResource Plain.ListBoxItem}"
                         ItemsSource="{Binding Visible}"
                         inf:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="11" CornerRadius="2" Margin="0,1,6,0"
                                                    Background="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                            <TextBlock Text="{Binding TimestampText}" Style="{StaticResource Text.Mono}" FontSize="9" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="8" FontWeight="Bold" Margin="7,0,0,0"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CategoryText}" FontSize="8" FontWeight="Bold" Margin="6,0,0,0"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LevelText}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"
                                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    </Grid>

                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Margin="9,3,0,0" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="9.5" Margin="9,2,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               Visibility="{Binding Detail, Converter={StaticResource StringVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding HasEntries, Converter={StaticResource BoolVisibilityInverse}}">
                    <Path Data="{StaticResource Icon.Logs}" Fill="{StaticResource Brush.BorderStrong}"
                          Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="No log entries yet" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Engine events and server detections appear here as they happen."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" FontSize="9" Margin="2,7,0,0" TextWrapping="Wrap"
                   Text="CLIENT rows are produced by this overlay. SERVER rows were reported by your testing service." />
    </Grid>
</UserControl>
