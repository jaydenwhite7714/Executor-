    <Geometry x:Key="Icon.Close">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</Geometry>
    <Geometry x:Key="Icon.ChevronLeft">M15,5 L16.4,6.4 L10.8,12 L16.4,17.6 L15,19 L8,12 Z</Geometry>
    <Geometry x:Key="Icon.ChevronRight">M9,5 L16,12 L9,19 L7.6,17.6 L13.2,12 L7.6,6.4 Z</Geometry>
    <Geometry x:Key="Icon.Check">M9.5,18 L4,12.5 L5.6,10.9 L9.5,14.8 L18.4,5.9 L20,7.5 Z</Geometry>
    <Geometry x:Key="Icon.Alert">M12,2 L23,21 H1 Z M11,9 H13 V15 H11 Z M11,17 H13 V19 H11 Z</Geometry>
    <Geometry x:Key="Icon.Play">M8,4.5 L19.5,12 L8,19.5 Z</Geometry>
    <Geometry x:Key="Icon.Stop">M6,6 H18 V18 H6 Z</Geometry>
    <Geometry x:Key="Icon.Bolt">M13,2 L4.5,13.5 H10 L9,22 L19.5,10 H13 Z</Geometry>

    <!-- ============================ Effects ============================ -->
    <DropShadowEffect x:Key="Effect.AccentGlow"
                      BlurRadius="20"
                      Color="#FF3B82F6"
                      Opacity="0.55"
                      ShadowDepth="0" />
    <DropShadowEffect x:Key="Effect.CardShadow"
                      BlurRadius="14"
                      Color="#FF000000"
                      Opacity="0.45"
                      ShadowDepth="2" />

</ResourceDictionary>
