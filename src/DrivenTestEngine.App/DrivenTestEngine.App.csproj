<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DrivenTestEngine.App</RootNamespace>
    <AssemblyName>DrivenTestEngine</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Driven Test Engine</AssemblyTitle>
    <Description>Overlay console for the Driven Football server-side testing system.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrivenTestEngine.Core\DrivenTestEngine.Core.csproj" />
  </ItemGroup>

</Project>
