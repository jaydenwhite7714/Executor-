<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DrivenTestEngine.App.ViewModels"
                    xmlns:views="clr-namespace:DrivenTestEngine.App.Views">

    <DataTemplate DataType="{x:Type vm:TestsViewModel}">
        <views:TestsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AntiCheatViewModel}">
        <views:AntiCheatView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LogsViewModel}">
        <views:LogsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <views:HistoryView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
        <views:ConnectionView />
    </DataTemplate>

</ResourceDictionary>
