    <Geometry x:Key="Icon.Jump">M12,2.5 L20,11 H15.5 V21.5 H8.5 V11 H4 Z</Geometry>
    <Geometry x:Key="Icon.Catch">M12,2 A10,10 0 1 1 11.999,2 Z M12,6.5 A5.5,5.5 0 1 1 11.999,6.5 Z M12,10.4 A1.6,1.6 0 1 1 11.999,10.4 Z</Geometry>
    <Geometry x:Key="Icon.Dime">M12,2 A10,10 0 1 1 11.999,2 Z M12,5 A7,7 0 1 1 11.999,5 Z M12,9 A3,3 0 1 1 11.999,9 Z</Geometry>
    <Geometry x:Key="Icon.Tests">M9,2 H15 V4 H13.5 V9.5 L19,19.2 A2,2 0 0 1 17.3,22 H6.7 A2,2 0 0 1 5,19.2 L10.5,9.5 V4 H9 Z</Geometry>
    <Geometry x:Key="Icon.Shield">M12,2 L20.5,5.5 V12 C20.5,17 17,21 12,22.5 C7,21 3.5,17 3.5,12 V5.5 Z</Geometry>
    <Geometry x:Key="Icon.Logs">M3,5 H21 V7.5 H3 Z M3,10.75 H21 V13.25 H3 Z M3,16.5 H14 V19 H3 Z</Geometry>
    <Geometry x:Key="Icon.History">M12,2 A10,10 0 1 1 11.999,2 Z M11,6 H13 V12.2 L17.2,14.7 L16.2,16.4 L11,13.4 Z</Geometry>
