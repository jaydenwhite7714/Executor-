<Window x:Class="DrivenTestEngine.App.Windows.EdgeTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driven Test Engine"
        Width="22"
        Height="128"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="TabChrome"
            CornerRadius="8,0,0,8"
            Background="{StaticResource Brush.EdgeTab}"
            BorderBrush="#663B82F6"
            BorderThickness="1,1,0,1"
            Cursor="Hand"
            Opacity="0"
            MouseLeftButtonDown="OnTabMouseDown"
            ToolTip="Show Driven Test Engine">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#FF1D4ED8" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icon.ChevronLeft}" Fill="White" Width="7" Height="7" Stretch="Uniform"
                  HorizontalAlignment="Center" Opacity="0.85" Margin="0,0,3,0" />
            <TextBlock Text="D" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,3,0" />
            <TextBlock Text="T" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,3,0" />
            <TextBlock Text="E" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,3,0" />
        </StackPanel>
    </Border>
</Window>
