<UserControl x:Class="DrivenTestEngine.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="720">

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <TextBlock Text="TEST HISTORY" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export CSV" Style="{StaticResource Button.Tiny}" Command="{Binding ExportCommand}" Margin="0,0,5,0" />
                <Button Content="Clear" Style="{StaticResource Button.Tiny}" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <!-- stats -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,9">
            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.Title}" FontSize="13" />
                    <TextBlock Text="archived runs" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="10,8" Margin="2,0,2,0">
                <StackPanel>
                    <TextBlock Text="{Binding PassRateText}" Style="{StaticResource Text.Title}" FontSize="13"
                               Foreground="{StaticResource Brush.Success}" />
                    <TextBlock Text="pass rate" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="10,8" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Text.Title}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="most recent" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- filters -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Button.Chip}" Margin="0,0,5,4"
                            Content="{Binding Label}"
                            Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- rows -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="2" Background="#FF0C1116">
            <Grid>
                <ListBox Style="{StaticResource Plain.ListBox}"
                         ItemContainerStyle="{StaticResource Plain.ListBoxItem}"
                         ItemsSource="{Binding Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,0,1"
                                    ToolTip="{Binding Message}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Chip}" Padding="5,1" VerticalAlignment="Center" MinWidth="52">
                                        <TextBlock Text="{Binding OutcomeText}" FontSize="8.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding State, Converter={StaticResource RunStateBrush}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TestName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Text.Caption}" FontSize="9" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MetricText}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding RunId}" Style="{StaticResource Text.Caption}" FontSize="8.5"
                                                   HorizontalAlignment="Right" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding HasRows, Converter={StaticResource BoolVisibilityInverse}}">
                    <Path Data="{StaticResource Icon.History}" Fill="{StaticResource Brush.BorderStrong}"
                          Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="No runs archived" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Completed server runs are stored here with the values the server returned."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
