<UserControl x:Class="DrivenTestEngine.App.Views.TestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="720">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,18">

            <Grid Margin="0,0,0,8">
                <TextBlock Text="SERVER-RUN TESTS" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- gate: not connected -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="11"
                    Visibility="{Binding IsGated, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Alert}" Fill="{StaticResource Brush.Warning}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GateTitle}" Style="{StaticResource Text.Title}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding GateMessage}" Style="{StaticResource Text.Body}" FontSize="11" Margin="0,7,0,0" />
                    <Button Content="Open connection" Style="{StaticResource Button.Primary}" Command="{Binding GoToConnectionCommand}"
                            HorizontalAlignment="Left" Margin="0,9,0,0" Padding="11,6" />
                </StackPanel>
            </Border>

            <!-- gate: verified -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="11" Background="#120F2E22" BorderBrush="#33204A38"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Check}" Fill="{StaticResource Brush.Success}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding GateMessage}" Style="{StaticResource Text.Body}" FontSize="10.5" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>

                                <!-- header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Brush.AccentSoft}"
                                            BorderBrush="#332F6BE0" BorderThickness="1" VerticalAlignment="Top">
                                        <Path Data="{Binding IconGeometry}" Fill="{StaticResource Brush.AccentBright}"
                                              Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Top"
                                            Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding State, Converter={StaticResource RunStateBrush}}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="11" Margin="0,9,0,0" />

                                <!-- Explicitly local UI controls; they do not affect Roblox or emit test results. -->
                                <Border Margin="0,9,0,0" Padding="9" CornerRadius="8"
                                        Background="#141B24" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                        Visibility="{Binding HasLocalPreview, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="LOCAL PREVIEW · NOT CONNECTED TO ROBLOX" Style="{StaticResource Text.Caption}"
                                                       Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{Binding PreviewToggleText}" Command="{Binding TogglePreviewCommand}"
                                                    Style="{StaticResource Button.Ghost}" MinWidth="54" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding PreviewStateText}" Style="{StaticResource Text.Caption}" Margin="0,5,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding PreviewValue}" IsSnapToTickEnabled="True"
                                                    TickFrequency="1" SmallChange="1" LargeChange="10" />
                                            <TextBlock Grid.Column="1" Text="{Binding PreviewValueText}" Style="{StaticResource Text.Mono}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,9,0,0" Padding="8" CornerRadius="7" Background="#1C1711"
                                        Visibility="{Binding IsUnsupportedIntegration, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IntegrationStatus}" Style="{StaticResource Text.Caption}"
                                                   Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button Content="DISABLED" IsEnabled="False" Style="{StaticResource Button.Ghost}"
                                                MinWidth="74" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- parameter -->
                                <Grid Margin="0,9,0,0" Visibility="{Binding HasParameter, Converter={StaticResource BoolVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ParameterLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Style="{StaticResource Slider.Param}" Margin="10,0"
                                            Minimum="{Binding ParameterMinimum}"
                                            Maximum="{Binding ParameterMaximum}"
                                            Value="{Binding ParameterValue}"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="{Binding ParameterStep}"
                                            SmallChange="{Binding ParameterStep}"
                                            LargeChange="{Binding ParameterStep}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ParameterText}" Style="{StaticResource Text.Mono}"
                                               VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" />
                                </Grid>

                                <!-- result -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"
                                                     Fill="{StaticResource Brush.AccentBright}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="PulseStory">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0.2" To="1" Duration="0:0:0.55"
                                                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="PulseStory" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding MetricText}" Style="{StaticResource Text.Metric}" FontSize="18" Margin="0,0,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" MaxHeight="46"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}" />
                                        <TextBlock Text="{Binding AvailabilityHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.Warning}"
                                                   Visibility="{Binding AvailabilityHint, Converter={StaticResource StringVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Cancel" Style="{StaticResource Button.Ghost}" Margin="0,0,6,0"
                                                Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
                                        <Button Content="{Binding RunButtonText}" Style="{StaticResource Button.Primary}"
                                                Command="{Binding RunCommand}" MinWidth="84" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Measures}" Style="{StaticResource Text.Caption}" Margin="0,9,0,0"
                                           FontSize="9.5" Foreground="{StaticResource Brush.TextSecondary}" Opacity="0.75" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0" FontSize="9.5">
                Speed/Jump preview sliders only change local UI state and do not affect Roblox. Server runs stay disabled until the service explicitly enables an implemented game integration.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
