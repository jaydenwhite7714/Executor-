<Window x:Class="DrivenTestEngine.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:DrivenTestEngine.App.Controls"
        mc:Ignorable="d"
        Title="Driven Test Engine"
        Width="432"
        Height="660"
        MinWidth="360"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource Brush.Window}"
        Topmost="{Binding Connection.KeepOnTop, Mode=OneWay}"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource Brush.Window}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== title bar ===================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.TitleBar}"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource Brush.AccentGradient}" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Bolt}" Fill="White" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Driven Test Engine" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Overlay console · Driven Football" Style="{StaticResource Text.Caption}" FontSize="9" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Tiny}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="connection"
                                Margin="0,0,6,0"
                                ToolTip="Connection status — open the link panel">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateBrush}}" />
                                <TextBlock Text="{Binding ConnectionPillText}" FontSize="8.5" FontWeight="Bold" Margin="5,0,0,0"
                                           Foreground="{Binding ConnectionState, Converter={StaticResource ConnectionStateBrush}}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Icon}" ToolTip="Hide to the edge tab"
                                Command="{Binding CollapseCommand}">
                            <Path Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource Brush.TextMuted}"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource Button.Icon}" ToolTip="Close Driven Test Engine"
                                Command="{Binding CloseCommand}" Margin="2,0,0,0">
                            <Path Data="{StaticResource Icon.Close}" Fill="{StaticResource Brush.TextMuted}"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== navigation ===================== -->
            <Border Grid.Row="1"
                    Background="#FF0C1015"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,0,0,1">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Nav}"
                                    Content="{Binding Label}"
                                    Height="50"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ===================== page ===================== -->
            <controls:MotionContentControl Grid.Row="2" Content="{Binding CurrentPage}" />

            <!-- ===================== status bar ===================== -->
            <Border Grid.Row="3"
                    Background="#FF0B0F14"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateBrush}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" FontSize="9"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SessionText}" Style="{StaticResource Text.Caption}" FontSize="8.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="130" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  " Style="{StaticResource Text.Caption}" FontSize="8.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" FontSize="8.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
